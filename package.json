{
  "name": "agent-walkin-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local bounded site understanding and WebMCP package generation tools",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
